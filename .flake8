[flake8]
max-line-length = 88
extend-ignore = E203,E501,F401,F403,F405
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .env,
    build,
    dist,
    *.egg-info,
    .pytest_cache,
    .coverage,
    htmlcov,
    .mypy_cache,
    .ruff_cache
per-file-ignores =
    # Ignore missing docstrings in test files
    tests/*:D100,D101,D102,D103,D104,D105,D106,D107
    # Ignore missing docstrings in __init__.py files
    */__init__.py:D104
    # Ignore line length in test files (they often have long strings)
    tests/*:E501 